{
  "name": "mapreport",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently -k \"wrangler dev --port 8787\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  }
}
